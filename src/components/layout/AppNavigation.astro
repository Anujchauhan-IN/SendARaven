---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => currentPath === href;

const primaryItems = [
  { href: '/', label: 'Rookery', icon: 'rookery' },
  { href: '/write', label: 'Write', icon: 'feather' },
  { href: '/flights', label: 'Flights', icon: 'map' },
  { href: '/inbox', label: 'Inbox', icon: 'mail' },
  { href: '/contacts', label: 'Contacts', icon: 'people' },
];
---
<header class="app-header">
  <details class="app-menu">
    <summary role="button" aria-label="Open navigation menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </summary>
    <nav aria-label="Menu navigation">
      {primaryItems.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href="/settings" aria-current={isCurrent('/settings') ? 'page' : undefined}>Settings</a>
    </nav>
  </details>

  <a class="brand" href="/" aria-label="SendARaven rookery">
    <span translate="no">SendARaven</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 4.5c-5.7.4-10 3.1-12.8 8.2L5 19l6.3-1.8c4.8-3 7.5-7.2 8.2-12.7ZM6.2 17.7l8.9-8.8M9.5 14.2l-2.2-.5M12.7 11l-.3-2.2" /></svg>
  </a>

  <nav class="desktop-nav" aria-label="Desktop primary navigation">
    {primaryItems.map((item) => (
      <a class:list={{ active: isCurrent(item.href) }} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
        {item.icon === 'rookery' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V10l8-7 8 7v11M8 21v-8a4 4 0 0 1 8 0v8M2 21h20" /></svg>}
        {item.icon === 'feather' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 4.5c-5.7.4-10 3.1-12.8 8.2L5 19l6.3-1.8c4.8-3 7.5-7.2 8.2-12.7ZM6.2 17.7l8.9-8.8M9.5 14.2l-2.2-.5M12.7 11l-.3-2.2" /></svg>}
        {item.icon === 'map' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3.5 5 5-2 7 2 5-2v16l-5 2-7-2-5 2V5Zm5-2v16m7-14v16" /></svg>}
        {item.icon === 'mail' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m4 7 8 6 8-6" /></svg>}
        {item.icon === 'people' && <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3" /><circle cx="17" cy="9" r="2.4" /><path d="M3.5 20v-2.2A4.8 4.8 0 0 1 8.3 13h1.4a4.8 4.8 0 0 1 4.8 4.8V20m.2-5.7a4 4 0 0 1 5.8 3.5V20" /></svg>}
        <span>{item.label}</span>
      </a>
    ))}
  </nav>

  <a class="notification-link" href="/inbox" aria-label="Inbox notifications" aria-current={isCurrent('/inbox') ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 17h11l-1.2-1.8V10a4.3 4.3 0 0 0-8.6 0v5.2L6.5 17ZM10 20h4" /></svg>
  </a>
  <a class:list={['account-seal', { active: isCurrent('/settings') }]} href="/settings" aria-label="Account settings" aria-current={isCurrent('/settings') ? 'page' : undefined}>A</a>
</header>

<nav class="mobile-nav" aria-label="Mobile primary navigation">
  {primaryItems.map((item) => (
    <a class:list={{ active: isCurrent(item.href) }} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
      {item.icon === 'rookery' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V10l8-7 8 7v11M8 21v-8a4 4 0 0 1 8 0v8M2 21h20" /></svg>}
      {item.icon === 'feather' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 4.5c-5.7.4-10 3.1-12.8 8.2L5 19l6.3-1.8c4.8-3 7.5-7.2 8.2-12.7ZM6.2 17.7l8.9-8.8M9.5 14.2l-2.2-.5M12.7 11l-.3-2.2" /></svg>}
      {item.icon === 'map' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3.5 5 5-2 7 2 5-2v16l-5 2-7-2-5 2V5Zm5-2v16m7-14v16" /></svg>}
      {item.icon === 'mail' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m4 7 8 6 8-6" /></svg>}
      {item.icon === 'people' && <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3" /><circle cx="17" cy="9" r="2.4" /><path d="M3.5 20v-2.2A4.8 4.8 0 0 1 8.3 13h1.4a4.8 4.8 0 0 1 4.8 4.8V20m.2-5.7a4 4 0 0 1 5.8 3.5V20" /></svg>}
      <span>{item.label}</span>
    </a>
  ))}
</nav>
