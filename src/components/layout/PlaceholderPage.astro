---
interface Props {
  heading: string;
  description: string;
}
const { heading, description } = Astro.props;
---
<main class="unfinished-page">
  <section aria-labelledby="unfinished-heading">
    <p class="unfinished-status">Unfinished functionality</p>
    <h1 id="unfinished-heading">{heading}</h1>
    <p>{description}</p>
    <p>This destination is available for navigation testing, but its product functionality has not been implemented.</p>
    <a href="/">Return to the Rookery</a>
  </section>
</main>
